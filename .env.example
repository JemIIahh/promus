# Copy to .env (gitignored) and fill in. NEVER commit real values.

# ── Brain (inference) ─────────────────────────────────────────────
# Get a key at console.anthropic.com → API Keys. Keep it secret.
ANTHROPIC_API_KEY=
# Optional model override (defaults to a current Claude model in code)
ANTHROPIC_MODEL=

# ── Storage (IPFS) ────────────────────────────────────────────────
# backend: 'ipfs' (default when PROMUS_IPFS_API_URL is set) or 'local' (dev)
PROMUS_STORAGE_BACKEND=ipfs
# IPFS HTTP API (Kubo). Local node: http://127.0.0.1:5001
PROMUS_IPFS_API_URL=http://127.0.0.1:5001
# Read gateway incl. trailing /ipfs. Local node: http://127.0.0.1:8080/ipfs
PROMUS_IPFS_GATEWAY=http://127.0.0.1:8080/ipfs
# Bearer token only if using an authenticated hosted endpoint (leave blank for local Kubo)
PROMUS_IPFS_API_TOKEN=

# ── Contract deployment (Foundry) ─────────────────────────────────
# Throwaway TESTNET deployer key (0x-prefixed). Generate with: cast wallet new
PRIVATE_KEY=
# For verifying contracts on Arbitrum Sepolia (Arbiscan/Etherscan V2). Optional.
ARBISCAN_API_KEY=
