# apps/web — the Promus landing + docs site.
#
# The site is fully static (landing pages + Markdown docs) and needs no
# runtime secrets. Copy this file to .env.local only if you add a feature
# that requires configuration.
#
# Absolute URL used for metadata/robots/llms.txt origins.
# TODO: real domain — promus.dev is a placeholder; the domain is not yet owned.
# NEXT_PUBLIC_SITE_ORIGIN="https://promus.dev"
#
# The interactive operator console (wallet + SIWE + blob proxy) has been
# retired; the `promus` CLI is the current interface. See
# https://github.com/JemIIahh/promus
